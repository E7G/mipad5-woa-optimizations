[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider    = %Provider_Name%
DriverVer   = 01/01/2021,22.39.10.250
CatalogFile = nt36xxx.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %Installation_Disk%,,,""

[SourceDisksFiles]
nt36xxx.sys  = 1,,
novatek_nt36523_fw01.bin=1
novatek_nt36523_fw02.bin=1

[Manufacturer]
%Manufacturer_Name% = Standard,NT$ARCH$.10.0...26100

[Standard.NT$ARCH$.10.0...26100]
%TchDriver_Device_Desc% = TchDriver_Device.NT, ACPI\NTTS3652

;*****************************************
; TchDriver client driver Install Section
;*****************************************

[TchDriver_Device.NT]
CopyFiles = TchDriver_Device.NT.CopyFiles
AddReg=TchDriver_Device.NT.Reg

[TchDriver_Device.NT.CopyFiles]
nt36xxx.sys
novatek_nt36523_fw01.bin
novatek_nt36523_fw02.bin

[TchDriver_Device.NT.Reg]
HKR,,"NVTFWImageHuaxingPath",%REG_SZ%,"%13%\novatek_nt36523_fw01.bin"
HKR,,"NVTFWImageTianmaPath",%REG_SZ%,"%13%\novatek_nt36523_fw02.bin"

[TchDriver_Device.NT.HW]
AddReg = FilterInst.NT.HW.AddReg

[FilterInst.NT.HW.AddReg]
HKR,,"UpperFilters",    %REG_MULTI_SZ%, mshidkmdf
HKR,,"MultiportDevice", %REG_DWORD%,    0

;-------------- Service installation
[TchDriver_Device.NT.Services]
AddService = nt36xxx, %SPSVCINST_ASSOCSERVICE%, TchDriver_Service_Inst

; ------------- TchDriver driver install section
[TchDriver_Service_Inst]
DisplayName    = %TchDriver_Service_Desc%
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_DEMAND_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
ServiceBinary  = %13%\nt36xxx.sys
LoadOrderGroup = Base

; ------------- Strings section
[Strings]
Provider_Name           = "Renegade Project"
Manufacturer_Name       = "Novatek"
Installation_Disk       = "Novatek nt36523 SPI Installation Disk"
TchDriver_Device_Desc   = "Novatek nt36523 SPI"
TchDriver_Service_Desc  = "Novatek nt36523 SPI Driver"

; ------------- non-localizable strings
SPSVCINST_ASSOCSERVICE  = 0x00000002
SERVICE_KERNEL_DRIVER   = 1
SERVICE_BOOT_START      = 0
SERVICE_SYSTEM_START    = 1
SERVICE_DEMAND_START    = 3
SERVICE_ERROR_NORMAL    = 1
SERVICE_ERROR_IGNORE    = 0
SERVICE_ERROR_CRITICAL  = 3
REG_EXPAND_SZ           = 0x00020000
REG_MULTI_SZ            = 0x00010000
REG_DWORD               = 0x00010001
REG_SZ                  = 0x00000000
